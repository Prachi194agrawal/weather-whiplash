# Local docker-compose dev defaults — copy to .env and adjust as needed.

# Used by the backend container (SQLite file inside the track_data volume)
INFERENCE_URL=http://inference:8500

# Used by the inference container: onnx (real trained model) or stub (heuristic, no model needed)
MODEL_BACKEND=onnx

# Baked into the frontend build (browser-facing backend URL)
VITE_API_URL=http://localhost:8000
